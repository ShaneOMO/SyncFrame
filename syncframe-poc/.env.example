# ===== SyncFrame 服务端配置（复制为 .env 后填写）=====
# 管理员账户：服务端启动时初始化（不存在则创建，已存在则提升为管理员）。
# 注册功能已关闭——全部账户由该管理员创建/删除/重置密码。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 说明：
# - OpenList 凭据由各账户在账户设置中填写并保存在服务端；B 站会话只保存在本机助手。
# - 游客（未登录）只能凭邀请码加入房间观看，不能创建房间或配置 provider。

# ===== 本机助手（每台观看设备运行 npm run p1:local）=====
# SYNCFRAME_LOCAL_PORT=8788
# SYNCFRAME_LOCAL_DATA_DIR=./data/local
# 公网部署时，把 SyncFrame 页面来源加入逗号分隔的白名单；不要填写云端反代地址。
# SYNCFRAME_WEB_ORIGINS=http://localhost:5173,https://syncframe.example.com
