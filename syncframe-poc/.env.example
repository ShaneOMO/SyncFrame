# ===== P0：OpenList 测试实例配置（复制为 .env 后填写）=====
# OpenList 实例地址，例如 http://192.168.1.10:5244 或 https://openlist.example.com
OPENLIST_BASE_URL=

# 测试账号：建议使用最小只读权限账号，不要使用管理员令牌
OPENLIST_USERNAME=
OPENLIST_PASSWORD=

# 要检查的目录（用于列目录 / 取文件详情），例如 /media/movies
OPENLIST_TEST_DIR=/

# 可选：指定单个文件路径做完整 HTTP 能力检查；留空则自动从目录中选视频文件
OPENLIST_TEST_FILE=

# 并发读取会话数（默认 5）
CHECK_CONCURRENCY=5
